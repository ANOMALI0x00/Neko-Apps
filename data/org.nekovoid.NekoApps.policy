<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Neko Void Linux</vendor>
  <vendor_url>https://github.com/Neko-Void-Linux</vendor_url>

  <action id="org.nekovoid.nekoapps.manage">
    <description>Ejecutar operaciones de gestión de paquetes del sistema</description>
    <message>Se requiere autenticación de administrador para instalar, actualizar o eliminar paquetes y repositorios del sistema</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/neko-apps/neko-apps-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
